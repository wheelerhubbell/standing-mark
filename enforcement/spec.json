      "require_pull_request": true,
      "allow_force_pushes": false,
      "allow_deletions": false
    },
    "wheelerhubbell/whp-sentinel-template": {
      "branch": "main",
      "required_checks": ["conformance"],
      "enforce_admins": true,
      "require_pull_request": true,
      "allow_force_pushes": false,
      "allow_deletions": false
    }
  },
  "tag_rulesets": {
